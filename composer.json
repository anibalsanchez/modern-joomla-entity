{
  "name": "anibalsanchez/modern-joomla-entity",
  "description": "Semantical API for Joomla! Reviewed for Joomla 3-6.x compatibility.",
  "license": "LGPL-2.1+",
  "keywords": [
    "joomla",
    "entity",
    "orm"
  ],
  "homepage": "https://github.com/anibalsanchez/modern-joomla-entity",
  "require": {
    "php": "^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^8.5"
  },
  "autoload": {
    "psr-4": {
      "Extly\\Joomla\\Entity\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Extly\\Joomla\\Entity\\Tests\\": "tests/tests"
    }
  },
  "config": {
    "allow-plugins": {
      "kylekatarnls/update-helper": true,
      "php-http/discovery": true
    },
    "optimize-autoloader": true,
    "platform": {
      "php": "8.0.30"
    },
    "preferred-install": "dist",
    "sort-packages": true
  },
  "scripts": {
    "test": "./vendor/bin/phpunit"
  }
}
